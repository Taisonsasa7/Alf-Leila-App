# Alf-Leila-App (ألف ليلة وليلة) - Environment Variables Configuration Template
# This file is for documentation and security template purposes only.

# General Configuration
APP_NAME="Alf-Leila-App"
APP_ENV="development" # development, staging, production
DEBUG=True

# Security Configuration
SECRET_KEY="your-super-secret-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Supabase Configuration
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Agora Configuration
AGORA_APP_ID="your-agora-app-id"
AGORA_APP_CERTIFICATE="your-agora-app-certificate"

# Audio & Rooms Configurations (Placeholder)
MAX_ROOM_PARTICIPANTS=100
